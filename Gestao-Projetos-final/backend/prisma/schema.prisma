datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Adicionando o campo updatedAt
  projects  Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  status      String
  dueDate     DateTime
  userId      Int
  user        User     @relation(fields: [userId], references: [id], map: "Project_userId_fkey")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // Adicionando o campo updatedAt
  tasks       Task[]
}

model Task {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  status      String
  dueDate     DateTime
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // Adicionando o campo updatedAt
}
